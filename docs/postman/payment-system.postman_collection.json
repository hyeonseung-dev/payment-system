{
  "info": {
    "_postman_id": "a7d07647-b153-4f62-9989-46d6c30c49f0",
    "name": "payment-system API",
    "description": "Spring Boot 결제/환불 팀프로젝트 로컬 통합 테스트용 Postman Collection입니다. payment-system-local 환경 파일을 함께 import한 뒤 순서대로 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response status is 2xx or expected error', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 409, 500]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "01 Signup",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test1@example.com\",\n  \"password\": \"abc123\",\n  \"name\": \"테스트\",\n  \"phoneNumber\": \"010-1234-5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "회원가입입니다. 이미 가입된 이메일이면 실패가 정상입니다."
          }
        },
        {
          "name": "02 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('login success', function () {",
                  "  pm.expect(json.code).to.eql('SUCCESS');",
                  "  pm.expect(json.data.accessToken).to.exist;",
                  "});",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.environment.set('accessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test1@example.com\",\n  \"password\": \"abc123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "로그인 성공 시 accessToken 환경 변수를 자동 저장합니다."
          }
        },
        {
          "name": "03 Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "로그아웃 후에는 accessToken이 블랙리스트에 등록됩니다. 전체 테스트 중간에는 실행하지 마세요."
          }
        }
      ]
    },
    {
      "name": "02 Product",
      "item": [
        {
          "name": "01 Get Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data;",
                  "const products = Array.isArray(data) ? data : (data && (data.products || data.content || data.items || data.productResponses));",
                  "if (Array.isArray(products) && products.length > 0) {",
                  "  const first = products[0];",
                  "  const id = first.productId || first.id;",
                  "  if (id) pm.environment.set('productId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "상품 목록 조회입니다. 응답 형태에 따라 첫 번째 상품 ID를 productId에 자동 저장하려고 시도합니다."
          }
        },
        {
          "name": "02 Get Product Detail",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 Cart",
      "item": [
        {
          "name": "01 Add Cart Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('cartItemId', json.data.cartItemId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "items"
              ]
            }
          }
        },
        {
          "name": "02 Get Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  if (json.data.cartId) pm.environment.set('cartId', json.data.cartId);",
                  "  if (!pm.environment.get('cartItemId') && Array.isArray(json.data.items) && json.data.items.length > 0) {",
                  "    pm.environment.set('cartItemId', json.data.items[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts"
              ]
            }
          }
        },
        {
          "name": "03 Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carts/items/{{cartItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "items",
                "{{cartItemId}}"
              ]
            }
          }
        },
        {
          "name": "04 Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carts/items/{{cartItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "items",
                "{{cartItemId}}"
              ]
            },
            "description": "삭제 테스트용입니다. 주문 테스트 전에 실행하면 주문할 cartItemId가 사라집니다."
          }
        }
      ]
    },
    {
      "name": "04 Order",
      "item": [
        {
          "name": "01 Preview Cart Order",
          "request": {
            "method": "POST",
