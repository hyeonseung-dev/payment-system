                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "preview"
              ]
            }
          }
        },
        {
          "name": "02 Create Cart Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('orderId', json.data.orderId);",
                  "  pm.environment.set('portonePaymentId', json.data.portonePaymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartItemIds\": [{{cartItemId}}],\n  \"usePointAmount\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "03 Create Product Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('orderId', json.data.orderId);",
                  "  pm.environment.set('portonePaymentId', json.data.portonePaymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2,\n  \"pointAmount\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "products"
              ]
            },
            "description": "장바구니 없이 바로 주문합니다. 이 요청을 사용하면 cartItemId 없이 주문 생성이 가능합니다."
          }
        }
      ]
    },
    {
      "name": "05 Payment",
      "item": [
        {
          "name": "01 Confirm Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('paymentId', json.data.paymentId);",
                  "  pm.environment.set('orderId', json.data.orderId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"portonePaymentId\": \"{{portonePaymentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "confirm"
              ]
            },
            "description": "실제 PortOne 결제창에서 portonePaymentId로 결제를 완료한 뒤 실행해야 성공합니다."
          }
        },
        {
          "name": "02 Cancel Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"결제 취소 테스트\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "cancel"
              ]
            },
            "description": "전체 취소 API입니다. 환불 테스트와 같은 결제로 같이 실행하지 마세요."
          }
        }
      ]
    },
    {
      "name": "06 Refund",
      "item": [
        {
          "name": "01 Partial Refund",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.environment.set('refundId', json.data.refundId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"단순 변심\",\n  \"items\": [\n    {\n      \"orderItemId\": {{orderItemId}},\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "refunds"
              ]
            },
            "description": "orderItemId는 현재 응답 API에서 내려주지 않으므로 DB의 order_items 테이블에서 확인해 환경 변수에 직접 넣어야 합니다."
          }
        },
        {
          "name": "02 Refund Quantity Exceeded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"초과 환불 테스트\",\n  \"items\": [\n    {\n      \"orderItemId\": {{orderItemId}},\n      \"quantity\": 999\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "{{paymentId}}",
                "refunds"
              ]
            },
            "description": "환불 가능 수량 초과 실패를 확인하는 요청입니다."
          }
        }
      ]
    },
